  <div class="lightbox-overlay" id="image-lightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="closeLightbox()">[ Close ]</button>
    <img class="lightbox-img" src="host.jpg" alt="Dhanush Chedadeepu Profile Lightbox"
      onclick="event.stopPropagation()">
  </div>

  <!-- ----------------------------------------------------
       INTERACTIVE CASE STUDY MODAL
       ---------------------------------------------------- -->
  <div class="modal-overlay" id="modal-overlay" onclick="closeModal()">
    <div class="modal-container" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div class="modal-title-wrapper">
          <span class="modal-category" id="modal-category">Project Details</span>
          <h3 id="modal-title">Project Case Study</h3>
        </div>
        <button class="modal-close" onclick="closeModal()">[ Close ]</button>
      </div>
      <div class="modal-body">
        <div class="modal-content-layout">
          <div class="modal-info-panel">
            <h4>Architectural Highlights</h4>
            <p id="modal-desc">
              Detailed breakdown of the systems architecture, implementation strategies, performance ratios, and
              engineered mechanics.
            </p>
            <div class="modal-spec-grid">
              <div class="spec-card-item">
                <span>My Role</span>
                <p id="modal-role">Lead Engineer</p>
              </div>
              <div class="spec-card-item">
                <span>Duration</span>
                <p id="modal-duration">3 Months</p>
              </div>
              <div class="spec-card-item">
                <span>Technology Stack</span>
                <p id="modal-stack">MERN Stack, CSS3</p>
              </div>
              <div class="spec-card-item">
                <span>Performance Metric</span>
                <p id="modal-perf">99/100 Lighthouse Ratio</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CORE JAVASCRIPT LOGIC SUITE -->
  <script src="script.js"></script>

  <!-- ================================================
       CINEMATIC INTRO OVERLAY
       ================================================ -->
  <div id="intro-overlay" aria-hidden="true">
    <!-- BG gradient + grid lines -->
    <div class="intro-bg"></div>

    <!-- Decorative accents -->
    <div class="intro-rule"></div>
    <div class="intro-stripes"></div>
    <div class="intro-dots">
      <div class="intro-dot"></div>
      <div class="intro-dot"></div>
      <div class="intro-dot"></div>
      <div class="intro-dot"></div>
      <div class="intro-dot"></div>
    </div>

    <!-- Two-column grid: text left | robot right -->
    <div class="intro-grid">

      <!-- LEFT: text -->
      <div class="intro-text-block">

        <!-- DHANUSH in massive letters (stagger injected by JS) -->
        <span class="intro-headline" id="intro-headline" aria-label="Dhanush"></span>

        <!-- Cyan scan line under name -->
        <span class="intro-scan-line"></span>

        <!-- CHEDADEEPU ghost line -->
        <span class="intro-subname">CHEDADEEPU</span>

        <!-- Role block -->
        <div class="intro-role-block">
          <span class="intro-cyan-bar"></span>
          <span class="intro-role-line">MERN STACK DEVELOPER</span>
          <span class="intro-role-line dim">AI EXPLORER &nbsp;•&nbsp; REACT ENGINEER &nbsp;•&nbsp; FULL-STACK BUILDER</span>
        </div>
      </div>

      <!-- RIGHT: robot -->
      <div class="intro-robot-col">
        <div class="intro-robot-glow"></div>
        <img class="intro-robot" src="falcon-robot.webp.webp" alt="" draggable="false">
      </div>
    </div>

    <!-- Skip button -->
    <button class="intro-skip" id="intro-skip-btn" onclick="dismissIntro()">SKIP &#9654;</button>

    <!-- Countdown progress bar -->
    <div class="intro-progress"></div>
  </div>

  <script>
    /* ── INTRO LETTER STAGGER ─────────────────── */
    (function buildIntroLetters() {
      const el = document.getElementById('intro-headline');
      if (!el) return;
      const word = 'DHANUSH';
      word.split('').forEach((ch, i) => {
        const span = document.createElement('span');
        span.className = 'letter';
        span.textContent = ch;
        span.style.animationDelay = (0.35 + i * 0.08) + 's';
        el.appendChild(span);
      });
    })();

    /* ── DISMISS LOGIC ───────────────────────── */
    function dismissIntro() {
      const overlay = document.getElementById('intro-overlay');
      if (!overlay || overlay.classList.contains('exit')) return;
      overlay.classList.add('exit');
      document.body.classList.remove('intro-active');
      setTimeout(() => {
        overlay.style.display = 'none';
        overlay.setAttribute('aria-hidden', 'true');
      }, 750);
    }

    /* ── AUTO-DISMISS AFTER 5.3s ─────────────── */
    document.body.classList.add('intro-active');
    setTimeout(dismissIntro, 5300);

    /* ── ESC KEY SKIP ────────────────────────── */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') dismissIntro();
    });
  </script>
</body>

</html>