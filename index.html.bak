<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dhanush Chedadeepu — Premium MERN Stack Developer</title>
  <meta name="description"
    content="Portfolio of Dhanush Chedadeepu, a high-end MERN Stack Developer & AI Explorer specializing in scalable web systems.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
    rel="stylesheet">

  <style>
    /* ----------------------------------------------------
       1. DESIGN SYSTEM & INITIALIZATION
       ---------------------------------------------------- */
    :root {
      --bg: #050d1a;
      --gold: #00d4ff;
      --gold-hover: #60e8ff;
      --gold-tint: rgba(0, 212, 255, 0.07);
      --gold-divider: rgba(0, 212, 255, 0.18);
      --text-primary: #e8f4ff;
      --text-secondary: rgba(232, 244, 255, 0.7);
      --text-muted: rgba(232, 244, 255, 0.45);
      --border-color: rgba(0, 212, 255, 0.15);
      --border: 0.5px solid rgba(0, 212, 255, 0.15);
      --font-headings: 'Playfair Display', serif;
      --font-display: 'Bebas Neue', sans-serif;
      --font-mono: 'DM Mono', monospace;
      --max-width: 1300px;
      --transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    section {
      scroll-margin-top: 110px;
      position: relative;
      z-index: 2;
    }

    body {
      background-color: var(--bg);
      /* ── Robot background image ── */
      background-image:
        linear-gradient(rgba(5,13,26,0.88), rgba(5,13,26,0.88)),
        url('falcon-robot.webp.webp');
      background-attachment: fixed;
      background-position: center center;
      background-size: cover;
      background-repeat: no-repeat;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 2px;
      line-height: 1.8;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border-color);
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--gold);
    }

    .container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 60px;
      position: relative;
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 24px;
      }
    }

    /* ----------------------------------------------------
       2. TYPOGRAPHY, BUTTONS & LABELS
       ---------------------------------------------------- */
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: var(--font-headings);
      font-weight: 400;
      letter-spacing: 0;
    }

    .display-label {
      font-family: var(--font-display);
      font-size: 13px;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: var(--gold);
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }

    .editorial-header {
      display: flex;
      align-items: baseline;
      gap: 20px;
      border-bottom: var(--border);
      padding-bottom: 24px;
      margin-bottom: 48px;
    }

    .editorial-num {
      font-family: var(--font-display);
      font-size: 2.2rem;
      letter-spacing: 2px;
      color: var(--gold);
    }

    .editorial-title {
      font-family: var(--font-headings);
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 400;
      color: var(--text-primary);
      text-transform: capitalize;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 32px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: var(--transition);
      border-radius: 0;
      border: 1px solid transparent;
      gap: 12px;
      will-change: transform;
    }

    .btn-primary {
      background-color: var(--gold);
      color: #050d1a;
      border-color: var(--gold);
    }

    .btn-primary:hover {
      background-color: transparent;
      color: var(--gold);
    }

    .btn-ghost {
      background-color: transparent;
      color: var(--gold);
      border-color: var(--gold);
    }

    .btn-ghost:hover {
      background-color: var(--gold);
      color: #050d1a;
    }

    /* ----------------------------------------------------
       2b. SCROLL PROGRESS BAR
       ---------------------------------------------------- */
    #scroll-progress {
      position: fixed;
      top: 0; left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(90deg, var(--gold), var(--gold-hover), var(--gold));
      background-size: 200% 100%;
      z-index: 1100;
      transition: width 0.1s linear;
      box-shadow: 0 0 8px rgba(0, 212, 255, 0.7);
      animation: shimmer-bar 2.5s linear infinite;
    }
    @keyframes shimmer-bar {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* ----------------------------------------------------
       2c. CURSOR SPOTLIGHT
       ---------------------------------------------------- */
    #cursor-spotlight {
      position: fixed;
      pointer-events: none;
      z-index: 1;
      width: 380px; height: 380px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0,212,255,0.06) 0%, transparent 70%);
      transform: translate(-50%, -50%);
      transition: opacity 0.4s ease;
      opacity: 0;
    }

    /* ----------------------------------------------------
       2d. STAGGERED CHILD REVEALS
       ---------------------------------------------------- */
    .reveal-child {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal-child.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ----------------------------------------------------
       2e. EDITORIAL NUMBER SHIMMER
       ---------------------------------------------------- */
    .editorial-num {
      position: relative;
      overflow: hidden;
    }
    .editorial-num.shimmer-active::after {
      content: '';
      position: absolute;
      top: 0; left: -75%;
      width: 55%; height: 100%;
      background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.45) 50%, transparent 100%);
      animation: num-shimmer 0.7s ease forwards;
    }
    @keyframes num-shimmer {
      from { left: -75%; }
      to   { left: 130%;  }
    }

    /* ----------------------------------------------------
       2f. TYPEWRITER CURSOR BLINK
       ---------------------------------------------------- */
    .typewriter-cursor {
      display: inline-block;
      width: 2px; height: 1em;
      background: var(--gold);
      margin-left: 3px;
      vertical-align: text-bottom;
      animation: cursor-blink 0.9s step-end infinite;
    }
    @keyframes cursor-blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }

    /* ----------------------------------------------------
       3. NAVIGATION BAR
       ---------------------------------------------------- */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 90px;
      z-index: 1000;
      background-color: rgba(10, 10, 10, 0.85);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-bottom: var(--border);
      transition: var(--transition);
    }

    nav.scrolled {
      height: 75px;
      background-color: rgba(10, 10, 10, 0.95);
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .logo {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 3px;
      font-weight: 500;
      text-decoration: none;
      color: var(--text-primary);
      text-transform: uppercase;
      transition: var(--transition);
      will-change: transform;
    }

    .logo:hover {
      color: var(--gold);
    }

    .nav-menu {
      display: flex;
      gap: 40px;
      list-style: none;
      align-items: center;
    }

    .nav-link {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2px;
      color: var(--text-secondary);
      text-decoration: none;
      text-transform: uppercase;
      transition: var(--transition);
      position: relative;
      padding: 6px 0;
      will-change: transform;
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--text-primary);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 1px;
      background-color: var(--gold);
      transition: var(--transition);
    }

    .nav-link.active::after,
    .nav-link:hover::after {
      width: 100%;
    }

    .nav-cta {
      color: var(--gold);
      border: 1px solid var(--gold);
      padding: 10px 20px;
      transition: var(--transition);
    }

    .nav-cta::after {
      display: none;
    }

    .nav-cta:hover {
      background-color: var(--gold);
      color: #0a0a0a;
    }

    /* Hamburger Menu Button */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 6px;
      cursor: pointer;
      border: none;
      background: transparent;
    }

    .hamburger span {
      display: block;
      width: 24px;
      height: 1px;
      background-color: var(--text-primary);
      transition: var(--transition);
    }

    .hamburger.active span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile Dropdown Menu */
    .mobile-menu {
      position: fixed;
      top: -100%;
      left: 0;
      width: 100%;
      background: rgba(10, 10, 10, 0.98);
      backdrop-filter: blur(20px);
      border-bottom: var(--border);
      padding: 120px 40px 40px;
      z-index: 999;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      gap: 24px;
      list-style: none;
    }

    .mobile-menu.active {
      top: 0;
    }

    .mobile-link {
      font-family: var(--font-mono);
      font-size: 14px;
      letter-spacing: 3px;
      color: var(--text-secondary);
      text-decoration: none;
      text-transform: uppercase;
      display: block;
    }

    .mobile-link:hover {
      color: var(--gold);
    }

    @media (max-width: 1024px) {
      .nav-menu {
        display: none;
      }

      .hamburger {
        display: flex;
      }
    }

    /* ----------------------------------------------------
       4. SECTION 01 — HERO
       ---------------------------------------------------- */
    #hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 140px;
      padding-bottom: 80px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 80px;
      align-items: center;
      width: 100%;
    }

    .hero-content {
      z-index: 2;
    }

    .hero-tagline {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--gold);
      margin-bottom: 32px;
    }

    .hero-tagline::before {
      content: '';
      width: 32px;
      height: 1px;
      background-color: var(--gold);
    }

    .hero-title {
      font-size: clamp(3rem, 6.5vw, 5rem);
      line-height: 1.05;
      font-weight: 300;
      margin-bottom: 24px;
      letter-spacing: -1px;
      color: var(--text-primary);
    }

    .hero-title .name {
      display: block;
    }

    .hero-title .italic-accent {
      font-style: italic;
      font-family: var(--font-headings);
      display: block;
      color: var(--gold);
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 32px;
    }

    .hero-bio {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      max-width: 580px;
      margin-bottom: 40px;
      line-height: 2;
      letter-spacing: 1.5px;
    }

    .hero-actions {
      display: flex;
      gap: 20px;
    }

    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .profile-frame {
      width: 100%;
      max-width: 400px;
      aspect-ratio: 1 / 1.15;
      border: var(--border);
      padding: 16px;
      background-color: transparent;
      position: relative;
      will-change: transform;
      transform-style: preserve-3d;
      perspective: 1000px;
    }

    .profile-inner {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
      border: var(--border);
      transform-style: preserve-3d;
    }

    .profile-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.15);
      transition: var(--transition);
      transform: translateZ(0px);
    }

    .profile-frame:hover .profile-img {
      transform: scale(1.05) translateZ(10px);
      filter: grayscale(0.5) contrast(1.1);
    }

    /* 3D Floating "VIEW" Button Overlay */
    .profile-overlay {
      position: absolute;
      inset: 0;
      background: rgba(10, 10, 10, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.4s ease;
      transform-style: preserve-3d;
      z-index: 5;
    }

    .profile-inner:hover .profile-overlay {
      opacity: 1;
    }

    .view-btn-3d {
      transform: translateZ(40px);
      background: rgba(0, 212, 255, 0.1);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--gold);
      color: var(--gold);
      padding: 12px 24px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 500;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(0, 212, 255, 0.15);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .view-btn-3d:hover {
      background: var(--gold);
      color: #050d1a;
      transform: translateZ(60px) scale(1.05);
      box-shadow: 0 15px 30px rgba(0, 212, 255, 0.35);
    }

    /* Staggered Fade Up Animations */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-up-0 {
      animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 0.1s;
      opacity: 0;
    }

    .fade-up-1 {
      animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 0.25s;
      opacity: 0;
    }

    .fade-up-2 {
      animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 0.4s;
      opacity: 0;
    }

    .fade-up-3 {
      animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 0.55s;
      opacity: 0;
    }

    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 60px;
        text-align: center;
      }

      .hero-tagline {
        justify-content: center;
      }

      .hero-tagline::before {
        display: none;
      }

      .hero-bio {
        margin: 0 auto 40px;
      }

      .hero-actions {
        justify-content: center;
      }

      .profile-frame {
        max-width: 340px;
        margin: 0 auto;
      }
    }

    /* ----------------------------------------------------
       5. SECTION 02 — ABOUT ME
       ---------------------------------------------------- */
    #about {
      padding: 100px 0;
    }

    .about-layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 80px;
      align-items: flex-start;
    }

    @media (max-width: 992px) {
      .about-layout {
        grid-template-columns: 1fr;
        gap: 60px;
      }
    }

    .about-philosophy {
      font-family: var(--font-headings);
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      line-height: 1.5;
      font-style: italic;
      color: var(--gold);
      margin-bottom: 32px;
      font-weight: 300;
    }

    .about-text {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 2;
      letter-spacing: 1.5px;
      margin-bottom: 24px;
    }

    .about-highlights-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    @media (max-width: 480px) {
      .about-highlights-grid {
        grid-template-columns: 1fr;
      }
    }

    .about-highlight-card {
      background-color: var(--gold-tint);
      border: var(--border);
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
      min-height: 180px;
    }

    .about-highlight-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 212, 255, 0.08);
    }

    .about-highlight-card span {
      display: block;
      font-family: var(--font-display);
      font-size: 13px;
      letter-spacing: 3px;
      color: var(--gold);
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .about-highlight-card p {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    /* ----------------------------------------------------
       6. SECTION 03 — SELECTED WORK
       ---------------------------------------------------- */
    #projects {
      padding: 100px 0;
    }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background-color: var(--gold-divider);
      border: var(--border);
    }

    @media (max-width: 768px) {
      .work-grid {
        grid-template-columns: 1fr;
      }
    }

    .project-card {
      background-color: var(--bg);
      padding: 60px 48px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 420px;
      position: relative;
      cursor: pointer;
      transition: background-color 0.4s ease;
      text-decoration: none;
      will-change: transform;
    }

    .project-card:hover {
      background-color: #0a1828;
    }

    /* Sweep Underline */
    .project-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 1.5px;
      background-color: var(--gold);
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project-card:hover::after {
      width: 100%;
    }

    .project-card.featured {
      grid-column: 1 / -1;
      min-height: 460px;
    }

    .project-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }

    .project-label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
    }

    .project-card-title {
      font-family: var(--font-headings);
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 400;
      color: var(--text-primary);
      margin-bottom: 16px;
      display: inline-block;
      position: relative;
    }

    .project-desc {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.8;
      max-width: 680px;
      margin-bottom: 40px;
    }

    .project-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: var(--border);
      padding-top: 24px;
    }

    .project-tags-list {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .project-tag-item {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .project-arrow-symbol {
      font-size: 1.5rem;
      color: var(--text-primary);
      transition: color 0.4s ease, transform 0.4s ease;
    }

    .project-card:hover .project-arrow-symbol {
      color: var(--gold);
      transform: translateX(8px);
    }

    @media (max-width: 576px) {
      .project-card {
        padding: 40px 24px;
        min-height: 360px;
      }
    }

    /* ----------------------------------------------------
       7. SECTION 04 — STATS ROW
       ---------------------------------------------------- */
    #stats {
      padding: 80px 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background-color: var(--gold-divider);
      border: var(--border);
    }

    @media (max-width: 992px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat-card {
      background-color: var(--bg);
      padding: 60px 32px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .stat-num {
      font-family: var(--font-display);
      font-size: clamp(4rem, 6.5vw, 6rem);
      color: var(--gold);
      line-height: 1;
      margin-bottom: 12px;
    }

    .stat-label {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--text-muted);
    }

    /* ----------------------------------------------------
       8. SECTION 05 — SKILLS & TOOLS
       ---------------------------------------------------- */
    #skills {
      padding: 100px 0;
    }

    .skills-editorial-wrap {
      max-width: 1000px;
      margin: 0 auto;
    }

    .skills-editorial-intro {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 2;
      letter-spacing: 1.5px;
      text-align: center;
      margin-bottom: 48px;
    }

    .skills-categories-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      margin-bottom: 48px;
    }

    @media (max-width: 768px) {
      .skills-categories-container {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }

    .skills-category-group {
      border: var(--border);
      padding: 28px;
      background-color: var(--gold-tint);
      transition: var(--transition);
    }

    .skills-category-group:hover {
      border-color: var(--gold-divider);
    }

    .skills-category-title {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 20px;
      border-bottom: 1.5px solid var(--gold-divider);
      padding-bottom: 8px;
    }

    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: flex-start;
    }

    .skill-badge {
      display: inline-block;
      padding: 14px 28px;
      border: 0.5px solid var(--gold);
      color: var(--gold);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      background-color: transparent;
      cursor: pointer;
      transition: var(--transition);
    }

    .skill-badge:hover,
    .skill-badge.active {
      background-color: var(--gold);
      color: #0a0a0a;
    }

    /* Popover */
    #skill-detail-panel {
      border: var(--border);
      background-color: var(--gold-tint);
      padding: 40px;
      margin-top: 48px;
      display: none;
    }

    .skill-detail-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 20px;
      border-bottom: var(--border);
      padding-bottom: 12px;
    }

    .skill-detail-title {
      font-family: var(--font-headings);
      font-size: 1.8rem;
      color: var(--gold);
    }

    .skill-detail-exp {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--text-muted);
    }

    .skill-detail-bar-wrap {
      height: 2px;
      background-color: rgba(240, 237, 230, 0.1);
      margin-bottom: 24px;
      position: relative;
    }

    .skill-detail-progress-line {
      height: 100%;
      background-color: var(--gold);
      width: 0%;
      transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .skill-detail-desc-text {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.8;
      color: var(--text-secondary);
      letter-spacing: 1.5px;
    }

    /* ----------------------------------------------------
       9. SECTION 06 — CREDENTIALS & ACHIEVEMENTS
       ---------------------------------------------------- */
    #achievements {
      padding: 100px 0;
    }

    .achievements-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    @media (max-width: 992px) {
      .achievements-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .achievements-grid {
        grid-template-columns: 1fr;
      }
    }

    .achievement-card {
      background-color: var(--bg);
      border: var(--border);
      padding: 40px 32px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 300px;
      position: relative;
      transition: var(--transition);
      cursor: pointer;
      text-decoration: none;
      will-change: transform;
    }

    .achievement-card:hover {
      border-color: var(--gold);
      background-color: #0a1828;
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 212, 255, 0.08);
    }

    .achievement-icon {
      font-size: 1.5rem;
      color: var(--gold);
      margin-bottom: 24px;
    }

    .achievement-title {
      font-family: var(--font-headings);
      font-size: 1.5rem;
      color: var(--text-primary);
      margin-bottom: 12px;
      line-height: 1.3;
    }

    .achievement-issuer {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .achievement-desc {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .achievement-date {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--gold);
      text-transform: uppercase;
      margin-top: 24px;
      border-top: var(--border);
      padding-top: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* ----------------------------------------------------
       10. SECTION 07 — CONTACT
       ---------------------------------------------------- */
    #contact {
      padding: 100px 0 60px;
    }

    .contact-architectural-layout {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 100px;
      align-items: flex-start;
      border-top: var(--border);
      padding-top: 60px;
    }

    @media (max-width: 992px) {
      .contact-architectural-layout {
        grid-template-columns: 1fr;
        gap: 60px;
      }
    }

    .contact-quote-col {
      display: flex;
      flex-direction: column;
    }

    .contact-editorial-quote {
      font-family: var(--font-headings);
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      font-style: italic;
      line-height: 1.4;
      color: var(--text-primary);
      font-weight: 300;
      margin-bottom: 40px;
    }

    .contact-cta-col {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .contact-label-mono {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--text-muted);
    }

    .contact-gold-email {
      font-family: var(--font-headings);
      font-style: italic;
      font-size: clamp(1.4rem, 3.2vw, 2.5rem);
      color: var(--gold);
      text-decoration: none;
      line-height: 1.4;
      display: inline-block;
      transition: var(--transition);
      border-bottom: 1px solid transparent;
      width: fit-content;
    }

    .contact-gold-email:hover {
      color: var(--text-primary);
      border-bottom: 1.5px solid var(--text-primary);
    }

    .contact-meta-details {
      margin-top: 24px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 1.5px;
      color: var(--text-muted);
      line-height: 2.2;
    }

    .contact-meta-details span {
      color: var(--text-secondary);
    }

    /* Form Styles */
    .contact-form-container {
      border: var(--border);
      padding: 48px;
      background-color: var(--gold-tint);
    }

    @media (max-width: 576px) {
      .contact-form-container {
        padding: 32px 20px;
      }
    }

    .contact-form-title {
      font-family: var(--font-headings);
      font-size: 1.8rem;
      margin-bottom: 40px;
      color: var(--text-primary);
    }

    .minimal-form {
      display: flex;
      flex-direction: column;
      gap: 32px;
      position: relative;
    }

    .form-field-wrapper {
      position: relative;
    }

    .minimal-form input,
    .minimal-form textarea {
      background: transparent;
      border: none;
      border-bottom: 0.5px solid rgba(240, 237, 230, 0.2);
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 16px 0;
      width: 100%;
      outline: none;
      transition: border-bottom-color 0.4s ease;
      letter-spacing: 1.5px;
    }

    .minimal-form input:focus,
    .minimal-form textarea:focus {
      border-bottom-color: var(--gold);
    }

    .minimal-form label {
      position: absolute;
      left: 0;
      top: 16px;
      color: var(--text-muted);
      pointer-events: none;
      transition: var(--transition);
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 2px;
    }

    .minimal-form input:focus~label,
    .minimal-form input:not(:placeholder-shown)~label,
    .minimal-form textarea:focus~label,
    .minimal-form textarea:not(:placeholder-shown)~label {
      top: -12px;
      font-size: 9px;
      color: var(--gold);
    }

    .minimal-form textarea {
      height: 120px;
      resize: none;
    }

    .error-msg {
      font-size: 10px;
      color: #ef4444;
      margin-top: 6px;
      display: block;
      opacity: 0;
      transition: var(--transition);
    }

    .form-field-wrapper.invalid input,
    .form-field-wrapper.invalid textarea {
      border-bottom-color: #ef4444 !important;
    }

    .form-field-wrapper.invalid .error-msg {
      opacity: 1;
    }

    .form-success-overlay {
      display: none;
      position: absolute;
      inset: 0;
      background-color: var(--bg);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 40px;
      z-index: 10;
      border: var(--border);
    }

    .form-success-title {
      font-family: var(--font-headings);
      font-size: 2rem;
      color: var(--gold);
      margin-bottom: 16px;
    }

    .form-success-desc {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      max-width: 440px;
      line-height: 2;
      margin-bottom: 32px;
    }

    /* Editorial Footer */
    .editorial-footer {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: var(--border);
      padding: 60px 0 40px;
      margin-top: 100px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--text-muted);
    }

    .align-center {
      text-align: center;
    }

    .align-right {
      text-align: right;
    }

    @media (max-width: 768px) {
      .editorial-footer {
        grid-template-columns: 1fr;
        gap: 20px;
        text-align: center;
      }

      .align-center,
      .align-right {
        text-align: center;
      }
    }

    /* ----------------------------------------------------
       11. PARTICLES BACKGROUND
       ---------------------------------------------------- */
    #particles-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      opacity: 0.35;
    }

    /* ----------------------------------------------------
       12. SCROLL REVEAL ANIMATIONS
       ---------------------------------------------------- */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* 3D Tilt container */
    [data-tilt] {
      will-change: transform;
      transition: transform 0.15s ease-out, box-shadow 0.25s ease-out;
    }

    /* ----------------------------------------------------
       13. LIGHTBOX & MODAL OVERLAY (LUXURY STYLE)
       ---------------------------------------------------- */
    .lightbox-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(10, 10, 10, 0.98);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lightbox-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-img {
      max-width: 90%;
      max-height: 80%;
      border: var(--border);
      filter: grayscale(0.5);
      transform: scale(0.95);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lightbox-overlay.active .lightbox-img {
      transform: scale(1);
    }

    .lightbox-close {
      position: absolute;
      top: 40px;
      right: 40px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-primary);
      background: transparent;
      border: none;
      cursor: pointer;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .lightbox-close:hover {
      color: var(--gold);
    }

    /* Case Study Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 10, 0.97);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
      padding: 24px;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .modal-container {
      width: 100%;
      max-width: 900px;
      background-color: var(--bg);
      border: var(--border);
      position: relative;
      transform: translateY(30px);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      max-height: 90vh;
      display: flex;
      flex-direction: column;
    }

    .modal-overlay.active .modal-container {
      transform: translateY(0);
    }

    .modal-header {
      padding: 40px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: var(--border);
    }

    .modal-title-wrapper h3 {
      font-size: 2rem;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .modal-category {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--gold);
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .modal-close {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-primary);
      background: transparent;
      border: none;
      cursor: pointer;
      letter-spacing: 2px;
      text-transform: uppercase;
      outline: none;
    }

    .modal-close:hover {
      color: var(--gold);
    }

    .modal-body {
      padding: 40px;
      overflow-y: auto;
    }

    .modal-content-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .modal-info-panel h4 {
      font-size: 1.4rem;
      margin-bottom: 16px;
      color: var(--text-primary);
    }

    .modal-info-panel p {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: 40px;
      letter-spacing: 1px;
    }

    .modal-spec-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      border-top: var(--border);
      padding-top: 32px;
    }

    @media (max-width: 600px) {
      .modal-spec-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }

    .spec-card-item span {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }

    .spec-card-item p {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-primary);
      font-weight: 500;
      margin: 0;
    }

    /* ====================================================
       CINEMATIC INTRO OVERLAY — SCI-FI CYAN THEME
       ==================================================== */
    :root {
      --ic:      #00f5ff;        /* intro cyan              */
      --ic-dim:  rgba(0,245,255,0.18);
      --ic-glow: rgba(0,245,255,0.55);
      --ib:      #050b1e;        /* intro background dark   */
      --ib2:     #0a1535;        /* intro bg mid blue       */
    }

    #intro-overlay {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: var(--ib);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: default;
    }
    #intro-overlay.exit {
      animation: intro-exit 0.75s cubic-bezier(0.7,0,1,1) forwards;
    }
    @keyframes intro-exit {
      0%   { opacity: 1; transform: scale(1);    filter: brightness(1);  }
      25%  { opacity: 1; transform: scale(1.03); filter: brightness(4) saturate(2); }
      100% { opacity: 0; transform: scale(1.12); pointer-events: none; }
    }

    /* ── BACKGROUND ────────────────────────────── */
    .intro-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 55% 45%, #0d2060 0%, #050b1e 65%),
        radial-gradient(ellipse 40% 40% at 75% 50%, rgba(0,245,255,0.07) 0%, transparent 70%);
      animation: intro-bg-in 0.6s ease forwards;
    }
    @keyframes intro-bg-in { from { opacity: 0; } to { opacity: 1; } }

    /* Subtle grid lines (techy look) */
    .intro-bg::after {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,245,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,245,255,0.025) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    /* ── DECORATIVE ACCENTS ─────────────────────── */
    .intro-rule {
      position: absolute;
      bottom: 17%; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,245,255,0.2) 25%, rgba(0,245,255,0.2) 75%, transparent);
      opacity: 0;
      animation: intro-fade-in 0.5s ease 2.6s forwards;
    }
    .intro-stripes {
      position: absolute;
      bottom: 17.5%; right: 0;
      width: 200px; height: 50px;
      overflow: hidden;
      opacity: 0;
      animation: intro-fade-in 0.5s ease 2.8s forwards;
    }
    .intro-stripes::before {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        -55deg,
        rgba(0,245,255,0.22) 0px, rgba(0,245,255,0.22) 3px,
        transparent 3px, transparent 12px
      );
    }
    .intro-dots {
      position: absolute;
      bottom: calc(17.5% + 7px);
      right: 208px;
      display: flex; gap: 6px;
      opacity: 0;
      animation: intro-fade-in 0.5s ease 3s forwards;
    }
    .intro-dot {
      width: 4px; height: 4px; border-radius: 50%;
      background: rgba(0,245,255,0.55);
    }
    @keyframes intro-fade-in { to { opacity: 1; } }

    /* ── TWO-COLUMN GRID LAYOUT ─────────────────── */
    .intro-grid {
      position: relative;
      z-index: 4;
      display: grid;
      grid-template-columns: 1fr 38%;
      align-items: center;
      width: 100%;
      max-width: 1500px;
      padding: 0 5vw;
      gap: 0;
      user-select: none;
    }

    /* ── TEXT COLUMN ────────────────────────────── */
    .intro-text-block {
      text-align: left;
    }

    /* "DHANUSH" — massive cyan-glowing headline */
    .intro-headline {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(12vw, 15vw, 18rem);
      line-height: 0.88;
      color: #ffffff;
      letter-spacing: -0.01em;
      white-space: nowrap;
      display: block;
      text-shadow:
        0 0 30px rgba(0,245,255,0.5),
        0 0 80px rgba(0,245,255,0.2);
      overflow: hidden;
    }
    .intro-headline .letter {
      display: inline-block;
      opacity: 0;
      transform: translateY(110%);
      animation: letter-rise 0.55s cubic-bezier(0.16,1,0.3,1) forwards;
    }
    @keyframes letter-rise { to { opacity: 1; transform: translateY(0); } }

    /* Cyan scan-line sweep under headline */
    .intro-scan-line {
      display: block;
      height: 2px;
      background: linear-gradient(90deg, var(--ic), rgba(0,245,255,0.1));
      box-shadow: 0 0 10px var(--ic);
      width: 0;
      margin-top: 2px;
      margin-bottom: 8px;
      opacity: 0;
      animation:
        intro-fade-in 0.1s ease 1.1s forwards,
        scan-expand 0.7s cubic-bezier(0.16,1,0.3,1) 1.1s forwards;
    }
    @keyframes scan-expand { to { width: 100%; } }

    /* "CHEDADEEPU" — ghost subtitle */
    .intro-subname {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4vw, 6vw, 6rem);
      line-height: 1;
      color: var(--ic-dim);
      letter-spacing: 0.2em;
      display: block;
      margin-top: 0.06em;
      opacity: 0;
      transform: translateX(-30px);
      animation: slide-in-left 0.65s cubic-bezier(0.16,1,0.3,1) 1.3s forwards;
    }
    @keyframes slide-in-left { to { opacity: 1; transform: translateX(0); } }

    /* Role subtitle block */
    .intro-role-block {
      margin-top: 1.5em;
      opacity: 0;
      animation: intro-fade-in 0.6s ease 2.3s forwards;
    }
    /* Cyan accent bar (replaces gold) */
    .intro-cyan-bar {
      display: block;
      width: clamp(50px, 7vw, 100px);
      height: 2px;
      background: linear-gradient(90deg, var(--ic), transparent);
      box-shadow: 0 0 8px var(--ic);
      margin-bottom: 10px;
    }
    .intro-role-line {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.2vw, 3vw, 2.8rem);
      letter-spacing: 0.1em;
      line-height: 1.15;
      color: #ffffff;
      display: block;
    }
    .intro-role-line.dim {
      color: rgba(0,245,255,0.6);
      font-size: clamp(1.4vw, 2vw, 1.8rem);
      letter-spacing: 0.22em;
      margin-top: 4px;
    }

    /* ── ROBOT COLUMN ───────────────────────────── */
    .intro-robot-col {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Cyan glow halo behind robot */
    .intro-robot-glow {
      position: absolute;
      inset: -20%;
      background: radial-gradient(ellipse at 50% 55%, rgba(0,245,255,0.14) 0%, transparent 65%);
      pointer-events: none;
      animation: robot-glow-pulse 3s ease-in-out 2s infinite;
    }
    @keyframes robot-glow-pulse {
      0%, 100% { opacity: 0.7; transform: scale(1);    }
      50%       { opacity: 1;   transform: scale(1.08); }
    }

    /* Robot image — edge-masked, no rectangular clip */
    .intro-robot {
      display: block;
      width: 100%;
      max-width: 560px;
      height: auto;
      mix-blend-mode: screen;
      filter: brightness(1.4) saturate(1.3) contrast(1.05);
      /* Radial mask: fades robot edges, removes box look */
      -webkit-mask-image: radial-gradient(
        ellipse 82% 88% at 50% 46%,
        black 45%, rgba(0,0,0,0.7) 65%, transparent 100%
      );
      mask-image: radial-gradient(
        ellipse 82% 88% at 50% 46%,
        black 45%, rgba(0,0,0,0.7) 65%, transparent 100%
      );
      opacity: 0;
      transform: scale(0.88) translateY(15px);
      animation: robot-appear 0.9s cubic-bezier(0.16,1,0.3,1) 1.7s forwards;
      pointer-events: none;
    }
    @keyframes robot-appear {
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ── SKIP BUTTON ────────────────────────────── */
    .intro-skip {
      position: absolute;
      bottom: 32px; right: 44px;
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: rgba(0,245,255,0.4);
      background: transparent;
      border: 1px solid rgba(0,245,255,0.2);
      padding: 9px 18px;
      cursor: pointer;
      z-index: 10;
      transition: color 0.3s, border-color 0.3s, box-shadow 0.3s;
      opacity: 0;
      animation: intro-fade-in 0.5s ease 2s forwards;
    }
    .intro-skip:hover {
      color: var(--ic);
      border-color: var(--ic);
      box-shadow: 0 0 12px rgba(0,245,255,0.3);
    }

    /* ── COUNTDOWN PROGRESS BAR ─────────────────── */
    .intro-progress {
      position: absolute;
      bottom: 0; left: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--ic), #0066ff);
      box-shadow: 0 0 10px var(--ic);
      width: 0%;
      opacity: 0;
      animation:
        intro-fade-in 0.3s ease 2s forwards,
        intro-progress-fill 3.2s linear 2s forwards;
    }
    @keyframes intro-progress-fill { from { width: 0%; } to { width: 100%; } }

    /* Hide scroll during intro */
    body.intro-active { overflow: hidden; }
  </style>
</head>

