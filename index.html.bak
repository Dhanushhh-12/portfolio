            <a href="mailto:chedadeepudhanush15@gmail.com" class="contact-gold-email">chedadeepudhanush15@gmail.com</a>
            <div class="contact-meta-details">
              <p>NAME: <span>Dhanush Chedadeepu</span></p>
              <p>LOCATION: <span>Hyderabad, Telangana, India</span></p>
              <p>PHONE: <span>+91 89196 47087</span></p>
            </div>
          </div>
        </div>

        <div class="contact-form-container">
          <h3 class="contact-form-title">Send A Direct Message</h3>

          <form class="minimal-form" id="portfolio-contact-form" novalidate>
            <div class="form-field-wrapper" id="name-wrapper">
              <input type="text" id="name" placeholder=" " required minlength="3">
              <label for="name">Your Name</label>
              <span class="error-msg">Name must be at least 3 characters.</span>
            </div>

            <div class="form-field-wrapper" id="email-wrapper">
              <input type="email" id="email" placeholder=" " required>
              <label for="email">Your Email Address</label>
              <span class="error-msg">Please enter a valid email address.</span>
            </div>

            <div class="form-field-wrapper" id="message-wrapper">
              <textarea id="message" placeholder=" " required minlength="10"></textarea>
              <label for="message">Describe Your Project</label>
              <span class="error-msg">Message must be at least 10 characters long.</span>
            </div>

            <div>
              <button type="submit" class="btn btn-primary" id="submit-btn">
                <span class="btn-text">Transmit Message</span>
                <span class="spinner" id="form-spinner"
                  style="display:none; width: 12px; height: 12px; border: 1.5px solid rgba(10,10,10,0.3); border-top-color: #0a0a0a; border-radius:50%; animation: spin 1s infinite linear;"></span>
              </button>
            </div>

            <!-- Glassmorphic Success Message Overlay Panel -->
            <div id="form-success-card" class="form-success-overlay">
              <h4 class="form-success-title">Transmission Successful</h4>
              <p class="form-success-desc">
                Your message was received successfully. Dhanush Chedadeepu will evaluate your parameters and reach back
                within 24 hours.
              </p>
              <button type="button" class="btn btn-ghost" id="reset-form-btn">Send Another Message</button>
            </div>
          </form>
        </div>
      </div>

