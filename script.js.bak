/* ====================================================
   1. STICKY HEADER STATE LOGIC
   ==================================================== */
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  if (navbar) {
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }
});


/* ====================================================
   2. MOBILE HAMBURGER TOGGLE LOGIC
   ==================================================== */
const hamburger = document.querySelector('.hamburger');
const mobileMenu = document.querySelector('.mobile-menu');

if (hamburger && mobileMenu) {
  hamburger.addEventListener('click', () => {
    mobileMenu.classList.toggle('active');
    hamburger.classList.toggle('active');
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('active');
      hamburger.classList.remove('active');
    });
  });
}


/* ====================================================
   3. ACTIVE NAVIGATION LINK STATE ON VIEWPORT SCROLL
   ==================================================== */
const sections = document.querySelectorAll('section');
const navLinks = document.querySelectorAll('.nav-link');

window.addEventListener('scroll', () => {
  let current = '';
  sections.forEach(section => {
    const sectionTop = section.offsetTop;
    if (window.pageYOffset >= (sectionTop - 180)) {
      current = section.getAttribute('id');
    }
  });

  navLinks.forEach(link => {
    link.classList.remove('active');
    if (link.getAttribute('href').includes(current)) {
      link.classList.add('active');
    }
  });
});


/* ====================================================
   4. STATS NUMBERS INTERACTIVE COUNTER UP ANIMATION
   ==================================================== */
const counters = document.querySelectorAll('.counter');
const statsSection = document.getElementById('stats');
let countersFired = false;

function fireCounters() {
  counters.forEach(counter => {
    counter.innerText = '0';
    const target = +counter.getAttribute('data-target');
    const increment = target / 30; // Speed scaling ratio

    const updateCounter = () => {
      const currentVal = +counter.innerText.replace('+', '').replace('%', '');
      if (currentVal < target) {
        let suffix = target === 100 ? '%' : '+';
        counter.innerText = Math.ceil(currentVal + increment) + suffix;
        setTimeout(updateCounter, 30);
      } else {
        let suffix = target === 100 ? '%' : '+';
        counter.innerText = target + suffix;
      }
    };
    updateCounter();
  });
}

const observerOptions = {
  threshold: 0.25
};

const counterObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !countersFired) {
      fireCounters();
      countersFired = true;
    }
  });
}, observerOptions);

if (statsSection) {
  counterObserver.observe(statsSection);
}


/* ====================================================
   5. INTERACTIVE SKILLS GRID DETAILS POPULATION PANEL
   ==================================================== */
const skillBadges = document.querySelectorAll('.skill-badge');
const skillDetailPanel = document.getElementById('skill-detail-panel');
const skillDetailName = document.getElementById('skill-detail-name');
const skillDetailExp = document.getElementById('skill-detail-exp');
const skillDetailProgress = document.getElementById('skill-detail-progress');
const skillDetailDesc = document.getElementById('skill-detail-desc');

skillBadges.forEach(badge => {
  badge.addEventListener('click', () => {
    // Toggle active design styles on badge
    skillBadges.forEach(b => b.classList.remove('active'));
    badge.classList.add('active');

    // Populate detail panel elements
    const name = badge.getAttribute('data-skill');
    const exp = badge.getAttribute('data-exp');
    const level = badge.getAttribute('data-level');
    const desc = badge.getAttribute('data-desc');

    if (skillDetailName) skillDetailName.innerText = name;
    if (skillDetailExp) skillDetailExp.innerText = exp;
    if (skillDetailDesc) skillDetailDesc.innerText = desc;

    // Show panel with smooth entry
    if (skillDetailPanel) {
      skillDetailPanel.style.display = 'block';

      // Slide transition for hairline progress indicator
      setTimeout(() => {
        if (skillDetailProgress) skillDetailProgress.style.width = level;
      }, 50);

      // Scroll view to focus cleanly on detail box
      skillDetailPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
});


/* ====================================================
   6. CONTACT FORM REAL-TIME VALIDATION & STATUS STATES
   ==================================================== */
const contactForm = document.getElementById('portfolio-contact-form');
const submitBtn = document.getElementById('submit-btn');
const spinner = document.getElementById('form-spinner');
const successCard = document.getElementById('form-success-card');
const resetFormBtn = document.getElementById('reset-form-btn');

// Validation rules
const validationRules = {
  name: (val) => val.trim().length >= 3,
  email: (val) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim()),
  message: (val) => val.trim().length >= 10
};

function validateField(inputEl) {
  const fieldId = inputEl.id;
  const val = inputEl.value;
  const rule = validationRules[fieldId];
  const wrapper = document.getElementById(`${fieldId}-wrapper`);

  if (wrapper) {
    if (rule && !rule(val)) {
      wrapper.classList.add('invalid');
      return false;
    } else {
      wrapper.classList.remove('invalid');
      return true;
    }
  }
  return true;
}

if (contactForm) {
  const formFields = contactForm.querySelectorAll('input, textarea');
  formFields.forEach(field => {
    field.addEventListener('input', () => {
      validateField(field);
    });
    field.addEventListener('blur', () => {
      validateField(field);
    });
  });

  // Form Submission
  contactForm.addEventListener('submit', (e) => {
    e.preventDefault();

    let formIsValid = true;
    formFields.forEach(field => {
      if (!validateField(field)) {
        formIsValid = false;
      }
    });

    if (!formIsValid) {
      return;
    }

    // Display loader
    if (submitBtn) {
      submitBtn.disabled = true;
      const btnText = submitBtn.querySelector('.btn-text');
      if (btnText) btnText.innerText = "Transmitting...";
    }
    if (spinner) spinner.style.display = 'inline-block';

    // Retrieve fields data
    const nameVal = document.getElementById('name').value;
    const emailVal = document.getElementById('email').value;
    const messageVal = document.getElementById('message').value;

    fetch("https://formsubmit.co/ajax/chedadeepudhanush15@gmail.com", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({
        name: nameVal,
        email: emailVal,
        message: messageVal,
        _subject: "New Portfolio Message from Dhanush Chedadeepu!"
      })
    })
      .then(res => res.json())
      .then(data => {
        if (submitBtn) {
          submitBtn.disabled = false;
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.innerText = "Transmit Message";
        }
        if (spinner) spinner.style.display = 'none';

        // Render success card overlays
        if (successCard) successCard.style.display = 'flex';
      })
      .catch(err => {
        console.error("Transmission error:", err);
        // Fallback to show success card overlay gracefully
        if (submitBtn) {
          submitBtn.disabled = false;
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.innerText = "Transmit Message";
        }
        if (spinner) spinner.style.display = 'none';
        if (successCard) successCard.style.display = 'flex';
      });
  });

  // Reset form overlays
  if (resetFormBtn) {
    resetFormBtn.addEventListener('click', () => {
      contactForm.reset();
      if (successCard) successCard.style.display = 'none';
      formFields.forEach(field => {
        const wrapper = document.getElementById(`${field.id}-wrapper`);
        if (wrapper) wrapper.classList.remove('invalid');
      });
    });
  }
}


